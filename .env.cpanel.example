DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=blandskron.cl,www.blandskron.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://blandskron.cl,https://www.blandskron.cl
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

DB_ENGINE=mysql
DB_NAME=replace-with-cpanel-db-name
DB_USER=replace-with-cpanel-db-user
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=3306

MCP_INTERNAL_API_TOKEN=replace-with-secret
MCP_ALLOWED_HOSTS=mcp.blandskron.cl
MCP_ALLOWED_ORIGINS=https://blandskron.cl

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=signals@blandskron.cl
EMAIL_HOST_PASSWORD=replace-with-mailbox-password
DEFAULT_FROM_EMAIL=signals@blandskron.cl

SITE_URL=https://blandskron.cl
SITE_NAME=Blandskron Signals
SITE_LANGUAGE=es
SITE_TIMEZONE=America/Santiago
